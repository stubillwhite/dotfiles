{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code needs your attention\" with title \"Claude Code\"'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/white1/dev/my-stuff/copilot-metrics/.venv/bin/python -m copilot_metrics record-interruption --provider claude --event Notification --output /Users/white1/.local/state/copilot-metrics/claude.jsonl"
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/white1/dev/my-stuff/copilot-metrics/.venv/bin/python -m copilot_metrics record-interruption --provider claude --event PermissionRequest --output /Users/white1/.local/state/copilot-metrics/claude.jsonl"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/white1/dev/my-stuff/copilot-metrics/.venv/bin/python -m copilot_metrics record-interruption --provider claude --event PreToolUse --output /Users/white1/.local/state/copilot-metrics/claude.jsonl"
          }
        ],
        "matcher": "AskUserQuestion"
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/white1/dev/my-stuff/copilot-metrics/.venv/bin/python -m copilot_metrics record-interruption --provider claude --event ElicitationResult --output /Users/white1/.local/state/copilot-metrics/claude.jsonl"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(duckdb *)",
      "mcp__codegraph__*"
    ]
  }
}
